// Keep the existing Pisces layout; cap wide screens at a comfortable reading width.
$content-desktop-large = 1120px;
$content-desktop-largest = 1120px;
$body-bg-color = #f5f6f8;
$font-family-chinese = 'PingFang SC', 'Microsoft YaHei', sans-serif;
$font-family-base = -apple-system, BlinkMacSystemFont, 'Segoe UI', $font-family-chinese;
$font-family-headings = $font-family-base;
$font-family-posts = $font-family-base;
$font-family-logo = $font-family-base;
$font-family-monospace = 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
